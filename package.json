{
  "name": "planka-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for a self-hosted Planka 2.x kanban instance (full card lifecycle)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbivia/planka-mcp-server.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "planka-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "node --env-file-if-exists=.env dist/index.js --check",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf dist",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.0"
  }
}
