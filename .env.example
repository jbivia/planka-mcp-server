# Racine de l'instance Planka. Le /api final est optionnel.
PLANKA_BASE_URL=https://planka.example.com

# Cle d'API Planka (menu utilisateur > Parametres > cle d'API).
# Acceptee aussi sous forme de JWT.
PLANKA_TOKEN=

# Repli si PLANKA_TOKEN est vide : le serveur echange ces identifiants
# contre un jeton au demarrage. Ne fonctionne pas si le compte a la 2FA.
# PLANKA_EMAIL=
# PLANKA_PASSWORD=

# Transport : "stdio" (defaut) ou "http" pour un connecteur distant.
# PLANKA_TRANSPORT=stdio
# PLANKA_HTTP_HOST=127.0.0.1
# PLANKA_HTTP_PORT=3000
# PLANKA_HTTP_PATH=/mcp
# Si defini, les appels HTTP doivent porter ce jeton en bearer.
# PLANKA_HTTP_TOKEN=
# Noms publics acceptes dans l'en-tete Host, separes par des virgules
# (le nom transmis par le reverse proxy).
# PLANKA_HTTP_ALLOWED_HOSTS=mcp-planka.example.com

# Duree de vie du cache de structure des tableaux, en ms. Pour ecrire de longs
# textes a un seul redacteur, 600000 (10 min) evite de relire le tableau entre
# deux appels.
# PLANKA_CACHE_TTL_MS=60000

# Si l'instance utilise une CA privee, pointer sur le certificat racine :
# NODE_EXTRA_CA_CERTS=/chemin/vers/ca.pem
